    <compiler angle="radian" meshdir="assets" autolimits="true"/>

<!--    <option cone="elliptic" impratio="100"/>-->

    <option iterations="1" ls_iterations="5" integrator="Euler" solver="Newton" gravity="0.0 0.0 -9.81" timestep="0.005">
